
{
  "Comment": "CodePilot-AI Autonomous Coding Workflow",
  "StartAt": "Plan",
  "States": {
    "Plan": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-2:399527676637:function:codepilot-planner",
      "Next": "Execute"
    },
    "Execute": {
      "Type": "Pass",
      "Parameters": {
        "task_id.$": "$.task_id",
        "task.$": "$.task",
        "iteration.$": "$.iteration",
        "success": false,
        "error": "ECS executor integration is pending"
      },
      "Next": "Observe"
    },
    "Observe": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-2:399527676637:function:codepilot-observer",
      "Next": "CheckResult"
    },
    "CheckResult": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.success",
          "BooleanEquals": true,
          "Next": "Success"
        },
        {
          "Variable": "$.iteration",
          "NumericGreaterThanEquals": 5,
          "Next": "Rollback"
        }
      ],
      "Default": "AnalyzeError"
    },
    "AnalyzeError": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-2:399527676637:function:codepilot-error-analyzer",
      "Next": "CheckCorrection"
    },
    "CheckCorrection": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.can_fix",
          "BooleanEquals": true,
          "Next": "Execute"
        }
      ],
      "Default": "Rollback"
    },
    "Rollback": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-2:399527676637:function:codepilot-rollback",
      "Next": "Failed"
    },
    "Success": {
      "Type": "Succeed"
    },
    "Failed": {
      "Type": "Fail",
      "Error": "CodePilotTaskFailed",
      "Cause": "Task exceeded safety limits or could not be safely corrected."
    }
  }
}
